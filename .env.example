# Copy this file to .env and adjust the values for your environment.
# Prisma 7 loads it through `import "dotenv/config";` in prisma.config.ts

# SQLite connection string
DATABASE_URL="file:./dev.db"

# Base URL of the studygap-ai (FastAPI) service used by the Next.js server for
# AI-generated practice papers and final exams: the Render deployment, with
# `https` and no trailing slash. Leave it unset to use this default.
STUDYGAP_API_URL="https://studygap-ai.onrender.com"

# Same address for the browser bundle. The upload page calls
# POST /process-document directly from the client, so this value is inlined at
# build time — restart/rebuild after changing it.
NEXT_PUBLIC_STUDYGAP_API_URL="https://studygap-ai.onrender.com"

# ---------------------------------------------------------------------------
# Login – the whole web app is private for a single user
# ---------------------------------------------------------------------------
# Defaults when unset: admin / Imachi.051937. Change both before exposing the app.
AUTH_USERNAME="admin"
AUTH_PASSWORD="Imachi.051937"
# Signs the session cookie; changing it logs out every existing session.
# Generate one with: openssl rand -base64 32   (or: node -p "crypto.randomBytes(32).toString('base64url')")
AUTH_SECRET="replace-with-a-long-random-string"
# Session cookies are marked `Secure` in production builds. Only set this to
# "false" when you open `npm run start` over plain HTTP (e.g. a LAN IP).
# AUTH_COOKIE_SECURE="false"

# ---------------------------------------------------------------------------
# Google OAuth – multi-user login through Auth.js (see auth.ts)
# ---------------------------------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> Create credentials
# -> OAuth client ID -> Application type "Web application".
#
# Authorized JavaScript origins
#   http://localhost:3000
# Authorized redirect URIs
#   http://localhost:3000/api/auth/callback/google
#
# Add every deployed origin/redirect URL (e.g. https://your-app.vercel.app and
# https://your-app.vercel.app/api/auth/callback/google) to the same client.
# `AUTH_SECRET` above also signs the Auth.js cookies – keep it long and random.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
