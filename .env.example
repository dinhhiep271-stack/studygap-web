# Copy this file to .env and adjust the values for your environment.
# Prisma 7 loads it through `import "dotenv/config";` in prisma.config.ts

# SQLite connection string
DATABASE_URL="file:./dev.db"

# Base URL of the studygap-ai (FastAPI) service used by the Next.js server for
# AI-generated practice papers and final exams. Optional: defaults to
# http://127.0.0.1:8000.
STUDYGAP_API_URL="http://127.0.0.1:8000"

# ---------------------------------------------------------------------------
# Login – the whole web app is private for a single user
# ---------------------------------------------------------------------------
# Defaults when unset: admin / Imachi.051937. Change both before exposing the app.
AUTH_USERNAME="admin"
AUTH_PASSWORD="Imachi.051937"
# Signs the session cookie; changing it logs out every existing session.
# Generate one with: openssl rand -base64 32   (or: node -p "crypto.randomBytes(32).toString('base64url')")
AUTH_SECRET="replace-with-a-long-random-string"
# Session cookies are marked `Secure` in production builds. Only set this to
# "false" when you open `npm run start` over plain HTTP (e.g. a LAN IP).
# AUTH_COOKIE_SECURE="false"
